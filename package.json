{
  "name": "solo-leveling-gym",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infra/db/migrate.ts"
  },
  "dependencies": {
    "next": "15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "framer-motion": "^11.3.19",
    "recharts": "^2.12.7",
    "zustand": "^4.5.5",
    "lucide-react": "^0.414.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.44.2",
    "@libsql/client": "^0.15.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.1",
    "eslint": "^9",
    "@eslint/eslintrc": "^3.3.0",
    "eslint-config-next": "15.5.22",
    "eslint-plugin-import": "^2.31.0",
    "drizzle-kit": "^0.31.1",
    "vitest": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@playwright/test": "^1.54.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0"
  }
}
